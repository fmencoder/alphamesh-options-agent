# ---------------------------------------------------------------------------
# AlphaMesh environment template. Copy to .env and fill in.
# NEVER commit a real .env file. All values below are placeholders.
# ---------------------------------------------------------------------------

# Paper trading is MANDATORY. The application refuses to start when this is
# anything other than "true", and refuses to start if any Alpaca endpoint below
# is not a recognised Alpaca paper endpoint.
ALPACA_PAPER=true

# Alpaca API credentials (paper keys only - generate at
# https://app.alpaca.markets/paper/dashboard/overview)
APCA_API_KEY_ID=PK_your_paper_key_id_here
APCA_API_SECRET_KEY=your_paper_secret_here

# Endpoints. Leave as-is unless Alpaca changes them. Live endpoints are rejected.
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_API_DATA_URL=https://data.alpaca.markets

# Anthropic key for the AI reasoning council. Optional: when unset, AlphaMesh
# falls back to the deterministic heuristic council and keeps trading.
ANTHROPIC_API_KEY=
ALPHAMESH_LLM_MODEL=claude-sonnet-5

# Storage
# On Railway this must sit on the mounted volume: DATABASE_PATH=/data/alphamesh.db
DATABASE_PATH=./data/alphamesh.db

# Runtime
# Seconds between cycles while the market is OPEN.
ALPHAMESH_LOOP_SECONDS=60
# Seconds between checks while the market is CLOSED. The agent backs off to
# this instead of re-scanning dead quotes, and never sleeps past the next open.
ALPHAMESH_CLOSED_POLL_SECONDS=300
# true  = in-process simulator, NO order reaches Alpaca, P&L is SIMULATED
# false = real Alpaca paper orders. Requires the API keys above; the agent
#         refuses to start with false and no credentials rather than
#         silently simulating.
ALPHAMESH_DRY_RUN=true
ALPHAMESH_LOG_LEVEL=INFO

# Market data source: "rest" (Alpaca REST via alpaca-py) or
# "mcp_capture" (replay of data captured through the Alpaca MCP server).
ALPHAMESH_DATA_SOURCE=rest
ALPHAMESH_CAPTURE_DIR=./data/mcp_capture

# Optional: path to the Alpaca CLI binary for the operational CLI adapter.
ALPACA_CLI_PATH=alpaca
